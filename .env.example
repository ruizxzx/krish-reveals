# Optional. The API defaults to port 8787 in development.
PORT=8787

# Set both to your verified production origin before launch. Do not include a trailing slash.
SITE_URL=
VITE_SITE_URL=

# Optional owner email notifications via Resend. Inquiries are stored in the admin inbox regardless.
# Create an API key at https://resend.com and verify the sender domain before enabling these.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
